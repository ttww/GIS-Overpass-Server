#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=../lib/common.sh
. "${SCRIPT_DIR}/../lib/common.sh"

KEEP_PBF=0
COUNTRY=""

for arg in "$@"; do
  case "$arg" in
    --keep-pbf) KEEP_PBF=1 ;;
    --yes | -y) ASSUME_YES=1 ;;
    -*) die "Unknown option: ${arg}" ;;
    *)
      if [ -n "$COUNTRY" ]; then
        usage_die "<country> [--keep-pbf] [--yes]"
      fi
      COUNTRY="$arg"
      ;;
  esac
done

require_country_arg "${COUNTRY:-}"
check_prereqs

require_known_country "$COUNTRY"

if country_fully_initialized "$COUNTRY"; then
  die "Country '${COUNTRY}' is already installed. Data dir: $(instance_dir "$COUNTRY")"
fi

INSTANCE_DIR="$(instance_dir "$COUNTRY")"
DB_DIR="${INSTANCE_DIR}/db"
INSTANCE_ENV="$(instance_env_path "$COUNTRY")"

if country_installed "$COUNTRY"; then
  log "Found an incomplete previous setup for '${COUNTRY}' — resuming."
  load_instance_env "$COUNTRY"
else
  log "Setting up ${COUNTRY}..."
  log ""
  log "PBF source:  ${CATALOG_PBF_URL}"
  log "Update feed: ${CATALOG_DIFF_URL}"
  log ""
  check_disk_space
  mkdir -p "$DB_DIR"
  PORT=$(allocate_port)
  log "Assigned port: ${PORT}"
fi

{
  echo "# AUTO-GENERATED by bin/setup-country — do not edit by hand."
  echo "PORT=${PORT}"
  echo "PBF_URL='${CATALOG_PBF_URL}'"
  echo "DIFF_URL='${CATALOG_DIFF_URL}'"
  echo "UPDATE_SLEEP=86400"
  echo "KEEP_PBF=${KEEP_PBF}"
  echo "INSTALLED_AT='$(date -u +%Y-%m-%dT%H:%M:%SZ)'"
} >"$INSTANCE_ENV"

# Resumable host-side download (see lib/common.sh download_pbf for why this
# is not left to the container). Safe to Ctrl-C and re-run setup-country to
# continue where it left off.
download_pbf "$CATALOG_PBF_URL" "${DB_DIR}/source.osm.pbf"

render_compose

log "Starting container overpass-${COUNTRY}..."
(cd "$ROOT_DIR" && docker compose up -d "overpass-${COUNTRY}")

wait_for_healthy "$COUNTRY"

if [ "$KEEP_PBF" -eq 0 ]; then
  rm -f "${DB_DIR}/source.osm.pbf"
else
  log "Keeping source PBF at ${DB_DIR}/source.osm.pbf (--keep-pbf)."
fi

DB_SIZE=$(dir_size_human "$DB_DIR")

log ""
log "Overpass ${COUNTRY} ready."
log ""
log "Endpoint:"
log "  http://localhost:${PORT}/api/interpreter"
log ""
log "Data directory:"
log "  ${INSTANCE_DIR}"
log ""
log "Database size:"
log "  ${DB_SIZE}"
