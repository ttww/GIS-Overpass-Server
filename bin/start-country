#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=../lib/common.sh
. "${SCRIPT_DIR}/../lib/common.sh"

COUNTRY="${1:-}"
require_country_arg "$COUNTRY"
check_prereqs
require_installed_country "$COUNTRY"

load_instance_env "$COUNTRY"
log "Starting overpass-${COUNTRY}..."
(cd "$ROOT_DIR" && docker compose up -d "overpass-${COUNTRY}")
log "overpass-${COUNTRY} started. Endpoint: http://localhost:${PORT}/api/interpreter"
