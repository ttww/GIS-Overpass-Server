#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=../lib/common.sh
. "${SCRIPT_DIR}/../lib/common.sh"

check_prereqs

COUNTRIES=$(list_installed_countries)
if [ -z "$COUNTRIES" ]; then
  log "No countries installed yet. Run: bin/setup-country <country>"
  exit 0
fi

printf '%-18s %-7s %-24s %-30s %s\n' "COUNTRY" "PORT" "CONTAINER" "STATUS" "DISK"
printf '%s\n' "------------------------------------------------------------------------------------------"

for country in $COUNTRIES; do
  load_instance_env "$country"
  name="overpass-${country}"
  status=$(container_ps_status "$country")
  if [ -z "$status" ]; then
    status="not created"
  fi
  disk=$(dir_size_human "$(instance_dir "$country")/db")
  printf '%-18s %-7s %-24s %-30s %s\n' "$country" "$PORT" "$name" "$status" "${disk:-?}"
done
