#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=../lib/common.sh
. "${SCRIPT_DIR}/../lib/common.sh"

COUNTRY="${1:-}"
require_country_arg "$COUNTRY"
check_prereqs
require_installed_country "$COUNTRY"

log "Stopping overpass-${COUNTRY}..."
(cd "$ROOT_DIR" && docker compose stop "overpass-${COUNTRY}")
log "overpass-${COUNTRY} stopped. Database is preserved at $(instance_dir "$COUNTRY")/db"
